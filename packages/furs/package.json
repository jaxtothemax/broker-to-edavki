{
  "name": "@taxreporter/furs",
  "version": "0.0.0",
  "private": true,
  "description": "TaxReporter FURS eDavki forms: form builders, schema-ordered XML writers and XSD validation (Doh-KDVP, Doh-Div).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "source": "./test/xsd.ts"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@taxreporter/core": "workspace:*",
    "@taxreporter/fx": "workspace:*"
  },
  "devDependencies": {
    "xmllint-wasm": "5.3.0"
  }
}
